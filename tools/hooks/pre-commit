#!/bin/sh
# Block locally-generated artifacts from being committed.
#
# WHY (Aug 26 2026): verification runs of `python3 -m src.main --code-only`
# regenerate docs/ and state/ on the local machine, where there is no
# ODDS_API_KEY. A `git add -A` swept those into three commits and published an
# empty report — the PWA showed an "odds api key missing" error — and created
# state/picks_<today>.json with zero picks and morning_singles_display already
# populated. That field is WRITE-ONCE, so the real morning run would have
# preserved the empty arrays and blanked the whole day's card.
#
# These files are CI's to write. If you genuinely need to commit one by hand:
#     ALLOW_GENERATED=1 git commit ...
set -e
[ -n "$ALLOW_GENERATED" ] && exit 0

TODAY=$(TZ=America/Los_Angeles date +'%Y-%m-%d')
STAGED=$(git diff --cached --name-only)
BLOCKED=""

for f in $STAGED; do
  case "$f" in
    docs/index.html|docs/index_spa.html|docs/sw.js|docs/health_latest.html|docs/debrief_latest.html)
      BLOCKED="$BLOCKED  $f\n" ;;
    "state/picks_$TODAY.json")
      BLOCKED="$BLOCKED  $f  (today's card — CI owns this)\n" ;;
  esac
done

if [ -n "$BLOCKED" ]; then
  printf '\n[pre-commit] BLOCKED — these are generated by CI, not by hand:\n'
  printf "$BLOCKED"
  printf '\nYour local runs have no ODDS_API_KEY, so committing these publishes an\n'
  printf 'empty report and can blank the day card (morning_*_display is write-once).\n\n'
  printf 'Unstage them:   git restore --staged <file>\n'
  printf 'Override:       ALLOW_GENERATED=1 git commit ...\n\n'
  exit 1
fi
exit 0
